# Binance Futures API credentials (64-char HMAC-SHA256 keys)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Oracle (OpenCode / DeepSeek) — optional; disables oracle gate if unset
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_API_ENDPOINT=https://ai.genfity.com/v1
OPENCODE_MODEL=genfity/gpt-5.5

# Dashboard control plane token — REQUIRED for all POST /api/control/* routes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set this in your environment before starting dashboard.py.
# Without it, all control POSTs return 503.
TRADE_CONTROL_TOKEN=your_secret_token_here
